<%= content_for :title, @document.title %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
  <div class="flex flex-wrap gap-4 justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @document.title %></h1>
      <p class="text-sm text-gray-500 mt-1">
        <%= status_badge(@document) %>
        <% if @document.client.present? %> · Cliente: <%= @document.client %><% end %>
        <% if @document.procedure_type.present? %> · <%= @document.procedure_type %><% end %>
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <% if @document.file.attached? %>
        <%= button_to "Reprocesar OCR", reprocess_document_path(@document), class: "bg-slate-700 hover:bg-slate-800 text-white text-sm font-medium py-2 px-4 rounded" %>
      <% end %>
      <% if @document.completed? %>
        <%= button_to "Validar datos", confirm_document_path(@document), method: :patch, class: "bg-green-600 hover:bg-green-700 text-white text-sm font-medium py-2 px-4 rounded" %>
      <% end %>
      <%= link_to "Editar", edit_document_path(@document), class: "bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-medium py-2 px-4 rounded" %>
      <%= link_to "Regresar", documents_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium py-2 px-4 rounded" %>
    </div>
  </div>

  <% if @document.processing? %>
    <div class="bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded text-sm">
      El OCR se está procesando. <%= link_to "Actualizar", @document, class: "underline" %> en unos segundos.
    </div>
  <% elsif @document.error? %>
    <div class="bg-red-50 border border-red-300 text-red-800 px-4 py-3 rounded text-sm">
      Error de OCR: <%= @document.ocr_error %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <section class="bg-white shadow sm:rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Datos detectados</h2>
      <% data_errors = @document.data_errors %>
      <% if @document.metadata.present? %>
        <dl class="divide-y divide-gray-100">
          <% @document.metadata.each do |key, value| %>
            <div class="py-2 grid grid-cols-3 gap-4">
              <dt class="text-sm font-medium text-gray-500"><%= LegalFields.label(key) %></dt>
              <dd class="text-sm col-span-2 <%= data_errors[key] ? "text-red-700" : "text-gray-900" %>">
                <%= value %>
                <% if data_errors[key] %><span class="block text-xs">Formato inválido</span><% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      <% else %>
        <p class="text-sm text-gray-500">Aún no hay datos. Sube un archivo o captúralos en “Editar”.</p>
      <% end %>
    </section>

    <section class="bg-white shadow sm:rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Autollenar formato</h2>
      <% if @templates.any? %>
        <%= form_with url: fill_document_path(@document), method: :get, class: "space-y-4" do |f| %>
          <div>
            <%= f.label :template_id, "Plantilla", class: "block text-sm font-medium text-gray-700" %>
            <%= f.select :template_id, @templates.map { |t| [t.library? ? "#{t.name} (biblioteca legal)" : t.name, t.id] }, {}, class: input_class %>
          </div>
          <%= f.submit "Generar vista previa", name: nil, class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded cursor-pointer" %>
        <% end %>
      <% else %>
        <p class="text-sm text-gray-500">No hay plantillas. <%= link_to "Crear una", new_template_path, class: "text-blue-600 underline" %>.</p>
      <% end %>

      <h3 class="text-sm font-medium text-gray-700 mt-8 mb-2">Archivo original</h3>
      <% if @document.file.attached? %>
        <p class="text-sm text-gray-900"><%= @document.file.filename %> (<%= number_to_human_size(@document.file.byte_size) %>)</p>
        <%= link_to "Descargar", rails_blob_path(@document.file, disposition: "attachment"), class: "text-sm text-blue-600 underline" %>
      <% else %>
        <p class="text-sm text-gray-500">Sin archivo adjunto.</p>
      <% end %>
    </section>
  </div>

  <% if @document.extracted_text.present? %>
    <details class="bg-white shadow sm:rounded-lg p-6">
      <summary class="text-lg font-medium text-gray-900 cursor-pointer">Texto extraído (OCR)</summary>
      <pre class="mt-4 text-xs text-gray-800 whitespace-pre-wrap max-h-96 overflow-y-auto bg-gray-50 p-4 rounded"><%= @document.extracted_text %></pre>
    </details>
  <% end %>

  <% if @issued_documents.any? %>
    <section class="bg-white shadow sm:rounded-lg p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Documentos emitidos con sello</h2>
      <ul class="divide-y divide-gray-100">
        <% @issued_documents.each do |issued| %>
          <li class="py-2 text-sm flex flex-wrap justify-between gap-2">
            <span>
              <strong><%= issued.template_name %></strong> · <%= l(issued.created_at, format: "%d/%m/%Y %H:%M") %>
              <span class="block font-mono text-xs text-gray-500 break-all">SHA-256 <%= issued.sha256 %></span>
            </span>
            <span class="flex gap-3">
              <%= link_to "Descargar PDF", rails_blob_path(issued.file, disposition: "attachment"), class: "text-blue-600 underline" %>
              <%= link_to "Verificación", verification_path(issued.token), class: "text-blue-600 underline" %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="bg-white shadow sm:rounded-lg p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Historial de auditoría</h2>
    <ul class="divide-y divide-gray-100">
      <% @versions.each do |version| %>
        <li class="py-2 text-sm flex flex-wrap justify-between gap-2">
          <span>
            <strong><%= Document::AUDIT_EVENTS.fetch(version.event, version.event) %></strong>
            por <%= @authors[version.whodunnit]&.full_name || "Sistema (OCR)" %>
          </span>
          <span class="text-gray-500"><%= l(version.created_at, format: "%d/%m/%Y %H:%M") %></span>
        </li>
      <% end %>
    </ul>
  </section>
</div>

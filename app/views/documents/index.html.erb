<%= content_for :title, "Documentos" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-wrap gap-4 justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Documentos</h1>
    <%= link_to "Nuevo Documento", new_document_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded" %>
  </div>

  <%= form_with url: documents_path, method: :get, class: "bg-white shadow sm:rounded-lg p-4 mb-6 grid grid-cols-1 md:grid-cols-6 gap-4 items-end", data: { turbo_frame: "_top" } do |f| %>
    <div class="md:col-span-2">
      <%= f.label :q, "Buscar (título, cliente o contenido)", class: "block text-xs font-medium text-gray-600" %>
      <%= f.search_field :q, value: params[:q], class: input_class %>
    </div>
    <div>
      <%= f.label :client, "Cliente", class: "block text-xs font-medium text-gray-600" %>
      <%= f.text_field :client, value: params[:client], class: input_class %>
    </div>
    <div>
      <%= f.label :procedure_type, "Tipo de trámite", class: "block text-xs font-medium text-gray-600" %>
      <%= f.select :procedure_type, @procedure_types, { include_blank: "Todos", selected: params[:procedure_type] }, class: input_class %>
    </div>
    <div>
      <%= f.label :status, "Estado", class: "block text-xs font-medium text-gray-600" %>
      <%= f.select :status, Document::STATUS_LABELS.invert, { include_blank: "Todos", selected: params[:status] }, class: input_class %>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <div>
        <%= f.label :from, "Desde", class: "block text-xs font-medium text-gray-600" %>
        <%= f.date_field :from, value: params[:from], class: input_class %>
      </div>
      <div>
        <%= f.label :to, "Hasta", class: "block text-xs font-medium text-gray-600" %>
        <%= f.date_field :to, value: params[:to], class: input_class %>
      </div>
    </div>
    <div class="md:col-span-6 flex gap-3 justify-end">
      <%= link_to "Limpiar", documents_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium py-2 px-4 rounded" %>
      <%= f.submit "Filtrar", name: nil, class: "bg-slate-800 hover:bg-slate-900 text-white text-sm font-medium py-2 px-4 rounded" %>
    </div>
  <% end %>

  <div class="bg-white shadow overflow-x-auto sm:rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <% ["Título", "Cliente", "Trámite", "Estado", "Fecha", "Acciones"].each do |heading| %>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @documents.empty? %>
          <tr>
            <td colspan="6" class="px-6 py-6 text-center text-sm text-gray-500">No se encontraron documentos.</td>
          </tr>
        <% end %>
        <% @documents.each do |document| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= link_to document.title, document, class: "hover:underline" %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= document.client %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= document.procedure_type %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm"><%= status_badge(document) %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= l(document.created_at.to_date, format: "%d/%m/%Y") %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <div class="flex space-x-3">
                <%= link_to "Ver", document, class: "text-indigo-600 hover:text-indigo-900" %>
                <%= link_to "Editar", edit_document_path(document), class: "text-yellow-600 hover:text-yellow-900" %>
                <%= link_to "Eliminar", document, data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este documento?" }, class: "text-red-600 hover:text-red-900" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

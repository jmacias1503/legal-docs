<%= content_for :title, "Verificación de documento" %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
  <h1 class="text-2xl font-bold text-gray-900">Verificación de documento</h1>

  <% if @issued_document %>
    <section class="bg-white shadow sm:rounded-lg p-6 space-y-4">
      <div class="bg-green-50 border border-green-300 text-green-900 px-4 py-3 rounded text-sm">
        Este folio corresponde a un documento emitido con DigitalLaw.
      </div>
      <dl class="divide-y divide-gray-100 text-sm">
        <div class="py-2 grid grid-cols-3 gap-4"><dt class="font-medium text-gray-500">Folio</dt><dd class="col-span-2 font-mono break-all"><%= @issued_document.token %></dd></div>
        <div class="py-2 grid grid-cols-3 gap-4"><dt class="font-medium text-gray-500">Emitido por</dt><dd class="col-span-2"><%= @issued_document.document.firm.name %></dd></div>
        <div class="py-2 grid grid-cols-3 gap-4"><dt class="font-medium text-gray-500">Formato</dt><dd class="col-span-2"><%= @issued_document.template_name %></dd></div>
        <div class="py-2 grid grid-cols-3 gap-4"><dt class="font-medium text-gray-500">Fecha de emisión</dt><dd class="col-span-2"><%= l(@issued_document.created_at, format: "%d/%m/%Y %H:%M") %></dd></div>
        <div class="py-2 grid grid-cols-3 gap-4"><dt class="font-medium text-gray-500">Huella SHA-256</dt><dd class="col-span-2 font-mono text-xs break-all"><%= @issued_document.sha256 %></dd></div>
      </dl>
    </section>

    <section class="bg-white shadow sm:rounded-lg p-6 space-y-4">
      <h2 class="text-lg font-medium text-gray-900">¿El archivo que tienes es el original?</h2>
      <% unless @match.nil? %>
        <div role="status" class="px-4 py-3 rounded text-sm <%= @match ? "bg-green-50 border border-green-300 text-green-900" : "bg-red-50 border border-red-300 text-red-900" %>">
          <%= @match ? "El archivo coincide con el documento emitido: no ha sido alterado." : "El archivo NO coincide con el documento emitido: puede haber sido modificado." %>
        </div>
      <% end %>
      <%= form_with url: verification_path(@issued_document.token), multipart: true, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :file, "Sube el PDF para comparar su huella", class: "block text-sm font-medium text-gray-700" %>
          <%= f.file_field :file, accept: "application/pdf", required: true, class: "mt-1 block w-full text-sm" %>
        </div>
        <%= f.submit "Comparar", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded cursor-pointer" %>
      <% end %>
    </section>
  <% else %>
    <div class="bg-red-50 border border-red-300 text-red-900 px-4 py-3 rounded text-sm">
      No existe ningún documento emitido con este folio.
    </div>
  <% end %>
</div>

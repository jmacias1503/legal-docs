<%= form_with(model: template, class: "space-y-6") do |form| %>
  <% if template.errors.any? %>
    <div class="bg-red-50 p-4 rounded-lg">
      <h2 class="text-sm font-medium text-red-800">No se pudo guardar la plantilla:</h2>
      <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
        <% template.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nombre de la plantilla", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, required: true, class: input_class %>
  </div>

  <div>
    <%= form.label :file, "Formato original (PDF, Word o texto)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.file_field :file, accept: "application/pdf,text/plain,#{OcrExtractor::DOCX}", class: "mt-1 block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
    <p class="mt-1 text-xs text-gray-500">Si dejas el cuerpo vacío, se extrae el texto del archivo para que solo agregues los marcadores.</p>
    <% if template.file.attached? %>
      <p class="mt-2 text-sm text-gray-700">Archivo actual: <strong><%= template.file.filename %></strong></p>
    <% end %>
  </div>

  <div>
    <%= form.label :body, "Cuerpo del formato", class: "block text-sm font-medium text-gray-700" %>
    <p class="text-xs text-gray-500">Usa marcadores como <code>{{nombre}}</code>, <code>{{rfc}}</code>, <code>{{fecha}}</code>, <code>{{cliente}}</code> o <code>{{fecha_actual}}</code>.</p>
    <%= form.text_area :body, rows: 16, class: "#{input_class} font-mono" %>
  </div>

  <% if template.placeholders.any? %>
    <fieldset class="space-y-3">
      <legend class="text-sm font-medium text-gray-700">Mapeo de campos</legend>
      <p class="text-xs text-gray-500">Indica de qué dato del documento se toma cada marcador.</p>
      <% sources = (%w[titulo cliente tipo_tramite fecha_actual] + LegalFields.keys).map { |key| [LegalFields.label(key), key] } %>
      <% template.placeholders.each do |placeholder| %>
        <div class="grid grid-cols-2 gap-4 items-center">
          <%= label_tag "template_field_mappings_#{placeholder}", "{{#{placeholder}}}", class: "text-sm font-mono text-gray-800" %>
          <%= select_tag "template[field_mappings][#{placeholder}]",
                options_for_select(sources, template.field_mappings.to_h[placeholder]),
                include_blank: "Campo con el mismo nombre", id: "template_field_mappings_#{placeholder}", class: input_class %>
        </div>
      <% end %>
    </fieldset>
  <% end %>

  <div class="flex justify-end space-x-4">
    <%= form.submit "Guardar plantilla", class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded cursor-pointer" %>
    <%= link_to "Cancelar", templates_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium py-2 px-4 rounded" %>
  </div>
<% end %>

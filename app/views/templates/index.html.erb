<%= content_for :title, "Plantillas" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-wrap gap-4 justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Plantillas documentales</h1>
    <%= link_to "Nueva Plantilla", new_template_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded" %>
  </div>

  <div class="bg-white shadow overflow-x-auto sm:rounded-lg">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <% ["Nombre", "Origen", "Marcadores", "Acciones"].each do |heading| %>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= heading %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @templates.empty? %>
          <tr>
            <td colspan="4" class="px-6 py-6 text-center text-sm text-gray-500">No hay plantillas. <%= link_to "Crear una", new_template_path, class: "text-blue-600 underline" %>.</td>
          </tr>
        <% end %>
        <% @templates.each do |template| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= link_to template.name, template, class: "hover:underline" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <% if template.library? %>
                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Biblioteca legal</span>
              <% else %>
                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Mi despacho</span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= template.placeholders.size %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-3">
              <%= link_to "Ver", template, class: "text-indigo-600 hover:text-indigo-900" %>
              <% unless template.library? %>
                <%= link_to "Editar", edit_template_path(template), class: "text-yellow-600 hover:text-yellow-900" %>
                <%= link_to "Eliminar", template, data: { turbo_method: :delete, turbo_confirm: "¿Eliminar esta plantilla?" }, class: "text-red-600 hover:text-red-900" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

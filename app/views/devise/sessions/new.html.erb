<%= content_for :title, "Iniciar sesión" %>

<div class="max-w-md mx-auto bg-white shadow sm:rounded-lg p-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Iniciar sesión</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "Correo electrónico", class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: input_class %>
    </div>

    <div>
      <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-gray-700" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: input_class %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-gray-300" %>
        <%= f.label :remember_me, "Recordarme", class: "text-sm text-gray-700" %>
      </div>
    <% end %>

    <%= f.submit "Entrar", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded cursor-pointer" %>
  <% end %>

  <div class="mt-4 text-sm text-center space-x-4">
    <%= link_to "Crear cuenta", new_registration_path(resource_name), class: "text-blue-600 underline" %>
    <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "text-blue-600 underline" %>
  </div>
</div>

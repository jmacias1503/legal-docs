<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} | DigitalLaw" : "DigitalLaw - Digitalización y Autollenado" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 min-h-screen flex flex-col font-sans">
    <nav class="bg-slate-900 text-white shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center space-x-6">
            <%= link_to root_path, class: "flex items-center space-x-2 text-xl font-bold text-blue-400" do %>
              <span>⚖️ DigitalLaw</span>
            <% end %>

            <% if user_signed_in? %>
              <div class="flex space-x-4 ml-6">
                <%= link_to "Documentos", documents_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-slate-800 #{'bg-slate-800' if current_page?(documents_path)}" %>
                <%= link_to "Plantillas", templates_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-slate-800 #{'bg-slate-800' if current_page?(templates_path)}" %>
                <%= link_to "Suscripción", subscription_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-slate-800 #{'bg-slate-800' if current_page?(subscription_path)}" %>
                <%= link_to "API", api_token_path, class: "px-3 py-2 rounded-md text-sm font-medium hover:bg-slate-800 #{'bg-slate-800' if current_page?(api_token_path)}" %>
              </div>
            <% end %>
          </div>

          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <span class="text-sm text-gray-300">
                <%= current_user.full_name.presence || current_user.email %> 
                <% if current_user.firm.present? %>
                  <span class="text-xs bg-blue-900 text-blue-200 px-2 py-0.5 rounded ml-1"><%= current_user.firm.name %></span>
                <% end %>
              </span>
              <%= button_to "Cerrar Sesión", destroy_user_session_path, method: :delete, class: "text-sm text-red-400 hover:text-red-300" %>
            <% else %>
              <%= link_to "Iniciar Sesión", new_user_session_path, class: "text-sm text-blue-400 hover:text-blue-300" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-grow py-8">
      <% if notice %>
        <div class="max-w-7xl mx-auto px-4 mb-4">
          <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline"><%= notice %></span>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div class="max-w-7xl mx-auto px-4 mb-4">
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
            <span class="block sm:inline"><%= alert %></span>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-slate-900 text-gray-400 text-xs text-center py-4 border-t border-slate-800">
      <p>DigitalLaw — Plataforma de Digitalización y Autollenado Documental (Equipo Threno)</p>
    </footer>
  </body>
</html>
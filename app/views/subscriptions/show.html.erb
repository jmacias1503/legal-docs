<%= content_for :title, "Suscripción" %>
<% plan = @firm.subscription_plan %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
  <h1 class="text-2xl font-bold text-gray-900">Suscripción de <%= @firm.name %></h1>

  <section class="bg-white shadow sm:rounded-lg p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
      <p class="text-xs font-medium text-gray-500 uppercase">Plan actual</p>
      <p class="text-xl font-semibold text-gray-900"><%= plan.name %></p>
      <p class="text-sm text-gray-600"><%= Firm::BILLING_CYCLES[@firm.billing_cycle] %> · <%= number_to_currency(plan.base_cents(@firm.billing_cycle) / 100.0) %></p>
    </div>
    <div>
      <p class="text-xs font-medium text-gray-500 uppercase">Documentos este mes</p>
      <p class="text-xl font-semibold text-gray-900"><%= @usage %> / <%= plan.included_documents %> incluidos</p>
      <% unless plan.allows?(@usage) %>
        <p class="text-sm text-red-700">Límite alcanzado: cambia de plan para subir más documentos.</p>
      <% end %>
    </div>
    <div>
      <p class="text-xs font-medium text-gray-500 uppercase">Excedente estimado del mes</p>
      <p class="text-xl font-semibold text-gray-900"><%= number_to_currency(plan.overage_cents(@usage) / 100.0) %></p>
      <p class="text-xs text-gray-500">
        Documentos extra: <%= Plan::OVERAGE_TIERS.map { |limit, price| "#{limit.infinite? ? "después" : "primeros #{limit}"} a #{number_to_currency(price / 100.0)}" }.join(", ") %>.
      </p>
    </div>
  </section>

  <section class="bg-white shadow sm:rounded-lg p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Planes</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% Plan.all.each do |option| %>
        <div class="border rounded-lg p-4 <%= option == plan ? "border-blue-600 ring-2 ring-blue-200" : "border-gray-200" %>">
          <h3 class="font-semibold text-gray-900"><%= option.name %></h3>
          <% if option.free? %>
            <p class="text-sm text-gray-600">Gratis · hasta <%= option.included_documents %> documentos al mes</p>
          <% else %>
            <p class="text-sm text-gray-600"><%= number_to_currency(option.monthly_cents / 100.0) %> al mes o <%= number_to_currency(option.annual_cents / 100.0) %> al año</p>
            <p class="text-sm text-gray-600"><%= number_with_delimiter(option.included_documents) %> documentos al mes incluidos; excedente por volumen</p>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if current_user.admin? %>
      <%= form_with model: @firm, url: subscription_path, method: :patch, class: "mt-6 flex flex-wrap gap-4 items-end" do |f| %>
        <div>
          <%= f.label :plan, "Plan", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :plan, Plan.all.map { |option| [option.name, option.key] }, {}, class: input_class %>
        </div>
        <div>
          <%= f.label :billing_cycle, "Periodo de cobro", class: "block text-sm font-medium text-gray-700" %>
          <%= f.select :billing_cycle, Firm::BILLING_CYCLES.invert, {}, class: input_class %>
        </div>
        <%= f.submit "Cambiar plan", class: "bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded cursor-pointer" %>
      <% end %>
    <% else %>
      <p class="mt-6 text-sm text-gray-500">Solo un administrador del despacho puede cambiar el plan.</p>
    <% end %>
  </section>

  <section class="bg-white shadow sm:rounded-lg p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Historial de uso</h2>
    <% if @history.any? %>
      <table class="min-w-full text-sm">
        <thead><tr class="text-left text-gray-500"><th class="py-2">Mes</th><th class="py-2">Documentos</th></tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% @history.each do |usage| %>
            <tr><td class="py-2"><%= l(usage.month, format: "%m/%Y") %></td><td class="py-2"><%= usage.documents_count %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-500">Aún no hay documentos registrados.</p>
    <% end %>
  </section>
</div>

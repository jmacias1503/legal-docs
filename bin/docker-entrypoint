#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  faltantes=""
  [ -z "${DB_HOST:-}" ] && faltantes="DB_HOST"
  [ -z "${DIGITALLAW_DATABASE_PASSWORD:-}" ] && faltantes="${faltantes:+$faltantes, }DIGITALLAW_DATABASE_PASSWORD"
  if [ -n "$faltantes" ]; then
    echo "Error: falta configurar la(s) variable(s) de entorno de la base de datos: $faltantes. Defínelas antes de iniciar el servidor." >&2
    exit 1
  fi

  ./bin/rails db:prepare
fi

exec "${@}"
